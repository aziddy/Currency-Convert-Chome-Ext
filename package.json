{
  "name": "usd-cad-price-converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first Chrome extension for USD and CAD price conversion.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node scripts/serve-demo.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.8",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
