{
  "manifest_version": 3,
  "name": "Price Converter · USD & CAD",
  "short_name": "Price Converter",
  "version": "1.0.0",
  "description": "Convert page prices between USD and CAD, with daily rates, custom rates, and per-site preferences.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://api.frankfurter.dev/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Convert prices · USD & CAD",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
